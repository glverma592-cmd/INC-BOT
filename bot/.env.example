# ---- zaroori ----
DISCORD_BOT_TOKEN=            # Developer Portal -> Bot -> Reset Token (ye webhook URL NAHI hai)

# ---- auto-DM / verify ----
VERIFY_ROLE_ID=               # role ID jo verify par mile (0 = button off)
WELCOME_CHANNEL_ID=           # DM fail ho to yahan fallback post
REQUIRE_VERIFY=1              # 1 = Verify button DM me aayega, 0 = sirf message

# ---- GitHub bridge (POST /github) ----
GITHUB_HOOK_SECRET=           # koi bhi random string; client se X-Hub-Secret header me bhejna
HTTP_PORT=8080

# ---- DM text (placeholders: {user} {guild} {count}) ----
DM_TEXT=Hey {user} 👋\n\n**{guild}** me swagat hai!\n\n1. Pehle #rules padho\n2. Neeche **Verify** button dabao\n3. Tabhi baaki channels khulenge
